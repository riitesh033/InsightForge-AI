DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/insightforge
SECRET_KEY=dev-local-secret-not-for-production
ENVIRONMENT=development
DEBUG=False
POSTGRES_DB=myapp
FRONTEND_URL=http://localhost:5173
# Local development storage defaults
DATASET_STORAGE_DIR=app/uploads/datasets
STUDENT_VERIFICATION_STORAGE_DIR=private_uploads/student_verification
# For Render, attach a Persistent Disk mounted at /var/data and use:
# DATASET_STORAGE_DIR=/var/data/insightforge/datasets
# STUDENT_VERIFICATION_STORAGE_DIR=/var/data/insightforge/student-verification
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Brevo transactional email API (runtime email provider)
BREVO_API_KEY=
SMTP_FROM_EMAIL=your-verified-brevo-sender@example.com
SMTP_FROM_NAME=InsightForge AI

# Legacy SMTP relay settings retained for compatibility/reference.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SUPPORT_EMAIL=support@insightforge.ai
BUSINESS_NAME=InsightForge AI
BUSINESS_ADDRESS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=insightforge-files
USE_CLOUD_STORAGE=false
